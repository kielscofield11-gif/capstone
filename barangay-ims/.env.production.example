# Production environment template for the Barangay IMS.
# Copy to .env on the server and replace every placeholder value.
# Never commit the resulting .env.

APP_NAME=BarangayIMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ims.example.com
BARANGAY_NAME="Barangay Concepcion"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Production databases normally listen on 3306. The local .env.example uses
# 3307 for the separate XAMPP instance used during development.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barangay_ims
DB_USERNAME=barangay_ims
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
# Must stay true when the site is served over HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@ims.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shared hosts like InfinityFree do not support `php artisan storage:link`
# (symlinks are blocked), so uploads cannot live in storage/app/public. Set this
# to true on those hosts: the public disk then writes to a real public/storage
# folder and /storage/... URLs resolve without a symlink. Leave it false on
# normal servers that can create the symlink.
PUBLIC_DISK_IN_WEBROOT=false

# Used only by `php artisan db:seed`. Set strong one-time values, run the
# seeder once, then remove them from .env. The deploy guides cover the exact
# flow per host (InfinityFree cannot run config:cache; see DEPLOY_INFINITYFREE.md).
SEED_ADMIN_PASSWORD=
SEED_SECRETARY_PASSWORD=
SEED_CAPTAIN_PASSWORD=
SEED_KAGAWAD_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_MOCK_DATA=false
ALLOW_MOCK_DATA_SEEDING=false

# Shared-host deployment helpers (InfinityFree only; see DEPLOY_INFINITYFREE.md).
# Leave these empty on servers with SSH and cron: unused endpoints stay disabled.
# SETUP_TOKEN gates the temporary deploy/infinityfree-setup.php script.
# SCHEDULER_TOKEN gates GET /scheduler/run, which external cron services call
# every minute so reminders:generate runs on schedule.
SETUP_TOKEN=
SCHEDULER_TOKEN=
